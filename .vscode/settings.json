{
  // Ctrl+Shift+B → default "build" task (timer scheduler).
  // Ctrl+Shift+P → "Tasks: Run Test Task" → default "test" task.
  "task.quickOpen.detail": true,
  "C_Cpp.default.compileCommands": "${workspaceFolder}/06-timer-scheduler/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/01-ring-buffer/include",
    "${workspaceFolder}/02-spsc-ring-buffer/include",
    "${workspaceFolder}/03-thread-pool/include",
    "${workspaceFolder}/04-event-bus/include",
    "${workspaceFolder}/05-async-logger/include",
    "${workspaceFolder}/06-timer-scheduler/include"
  ],
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/06-timer-scheduler"
  ],
  "files.eol": "\n"
}
