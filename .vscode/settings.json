{
  // Ctrl+Shift+B → default "build" task (signal/slot).
  // IntelliSense: clangd + workspace-root compile_commands.json (all projects/tests).
  "task.quickOpen.detail": true,
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/01-ring-buffer/include",
    "${workspaceFolder}/02-spsc-ring-buffer/include",
    "${workspaceFolder}/03-thread-pool/include",
    "${workspaceFolder}/04-event-bus/include",
    "${workspaceFolder}/05-async-logger/include",
    "${workspaceFolder}/06-timer-scheduler/include",
    "${workspaceFolder}/07-arena-allocator/include",
    "${workspaceFolder}/08-blocking-mpmc-queue/include",
    "${workspaceFolder}/09-task-graph/include",
    "${workspaceFolder}/10-signal-slot/include"
  ],
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--background-index"
  ],
  "files.eol": "\n"
}
