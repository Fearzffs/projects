      "windows": {
        "options": {
          "shell": {
            "executable": "C:\\Windows\\System32\\wsl.exe",
            "args": ["-e", "bash", "-lc"]
          }
        },
        "command": "cd \"$(wslpath -a '${workspaceFolder}')\" && cmake -S 02-spsc-ring-buffer -B 02-spsc-ring-buffer/build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_COMPILER=g++ && cmake --build 02-spsc-ring-buffer/build -j\"$(nproc)\""
      },
