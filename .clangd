# Helps clangd resolve cross-folder headers (02 SPSC) when editing 05.
CompileFlags:
  Add:
    - -std=c++2a
    - -I05-async-logger/include
    - -I04-event-bus/include
    - -I03-thread-pool/include
    - -I02-spsc-ring-buffer/include
    - -I01-ring-buffer/include
  CompilationDatabase: 05-async-logger/build
