# Prefer the source-tree CDB (written by 08's CMakeLists); it is not overwritten
# with googletest _deps entries on every cmake configure.
CompileFlags:
  Add:
    - -std=c++2a
    - -I08-blocking-mpmc-queue/include
    - -I07-arena-allocator/include
    - -I06-timer-scheduler/include
    - -I05-async-logger/include
    - -I04-event-bus/include
    - -I03-thread-pool/include
    - -I02-spsc-ring-buffer/include
    - -I01-ring-buffer/include
  CompilationDatabase: 08-blocking-mpmc-queue
